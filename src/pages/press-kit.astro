---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "../components/Contact.astro";
import { site, skills } from "../data/site";

const facts = [
  ["Title", site.name],
  ["Developer", `${site.person}, publishing as ${site.studio}`],
  ["Genre", "Idle guild RPG"],
  ["Platform", "iPhone (iOS 15 or later)"],
  ["Status", site.appStoreUrl ? "Out now" : site.status],
  ["Price", `Free to start. One purchase of ${site.price} for the full game.`],
  ["Ads", "None"],
  ["Online", "Not needed. Saves stay on the device."],
  ["Language", "English"],
];

const shots = [
  ["shot-camp-plain", "The camp"],
  ["shot-camp", "Build your guild"],
  ["shot-dragon", "The draigon"],
  ["shot-map", "The map"],
  ["shot-raid", "A raid"],
  ["shot-den", "The Wolf Den"],
  ["shot-ruin", "The Ruin"],
  ["shot-watch", "The dragon's watch"],
  ["shot-back", "Home again"],
  ["shot-grow", "The guild grows"],
];
---

<BaseLayout
  title="Press Kit"
  description="Facts, a description, images and the trailer for anyone writing about or covering Draigon Idle."
>
  <section class="page-head">
    <div class="container">
      <h1>Press Kit</h1>
      <p>
        Facts, words and pictures for anyone covering {site.name}. Use any of it
        freely. For anything else, reach us at <Contact />.
      </p>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <div class="press-grid">
        <div class="panel">
          <h2>Facts</h2>
          <dl class="facts">
            {
              facts.map(([k, v]) => (
                <>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </>
              ))
            }
          </dl>
        </div>

        <div class="panel">
          <h2>In one line</h2>
          <p>{site.tagline}</p>
          <h2>In a paragraph</h2>
          <p>
            {site.name} is an idle guild game for iPhone. You lead a small guild in
            Briarhold. Its members gather, craft and go out on expeditions while the
            game is closed, for up to 12 hours at a time. When you check in you collect
            what they found, gear them up and send them further: down the Old Mine,
            into the Wolf Den, out to sea on a boat that grows from a raft to a
            galleon. Along the way you raise four dragons, and four of the places you've
            beaten can be fought again by hand as raids.
          </p>
        </div>
      </div>

      <div class="panel" style="margin-bottom: 22px;">
        <h2>What's in it</h2>
        <ul class="ticks" role="list">
          <li>Ten skills: {skills.join(", ")}.</li>
          <li>Eighteen places to send a party, by land and by sea, across two camps.</li>
          <li>Four raids played by hand, with timed blows, drawn bows, traced runes and parries.</li>
          <li>Four dragons to feed and win over, each with five stages of trust.</li>
          <li>Ten ships, from the Raft to the Galleon.</li>
          <li>Five tiers of gear from scrap to tidesteel, plus sea, archery and magic kits, all drawn on the wearer.</li>
          <li>A rhythm game by the fire, played on drum, flute or lute.</li>
          <li>No ads, no energy, no timers to pay past, no account.</li>
        </ul>
      </div>

      <div class="panel" style="margin-bottom: 22px;">
        <h2>Price</h2>
        <p>
          The game is free through all of Briarhold, which is about a week of play:
          the camp, three land raids, the first five boats and a sea raid. One
          purchase of {site.price} opens the Saltmire Coast, with a second camp, five
          bigger ships, nine more places and the rest of the story. There is nothing
          else to buy.
        </p>
      </div>

      <div class="panel" style="margin-bottom: 22px;">
        <h2>Trailer</h2>
        <p>
          30 seconds, vertical, 720 by 1280.
          <a href="/video/draigon-idle-trailer.mp4" download>Download the MP4</a>
        </p>
      </div>

      <div class="panel" style="margin-bottom: 22px;">
        <h2>Icon and key art</h2>
        <ul class="downloads" role="list">
          <li>
            <a href="/images/app-icon.png" download>
              <img class="pixel contain" src="/images/app-icon.png" alt="The app icon: a red dragon's head." width="256" height="256" style="aspect-ratio: 1;" loading="lazy" />
              App icon (PNG)
            </a>
          </li>
          <li>
            <a href="/images/hero-night.png" download>
              <img class="pixel wide" src="/images/hero-night.png" alt="The camp at night." width="480" height="210" loading="lazy" />
              Camp at night (PNG, pixel size)
            </a>
          </li>
          <li>
            <a href="/og-default.png" download>
              <img class="wide" src="/og-default.png" alt="The title card." width="1200" height="630" loading="lazy" />
              Title card (PNG, 1200 by 630)
            </a>
          </li>
        </ul>
      </div>

      <div class="panel">
        <h2>Scenes from the trailers</h2>
        <p class="fine" style="margin-bottom: 16px;">Vertical, 540 by 960. Select one to download it.</p>
        <ul class="downloads" role="list">
          {
            shots.map(([file, label]) => (
              <li>
                <a href={`/images/${file}.webp`} download>
                  <img src={`/images/${file}.webp`} alt={label} width="540" height="960" loading="lazy" />
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
