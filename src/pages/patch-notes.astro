---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

// Newest first. Each release: version, date, a line about it, and
// headed lists of what changed.
const releases = [
  {
    version: "0.9.0",
    date: "2026-10-06",
    label: "Beta, on TestFlight",
    summary:
      "The first build in testers' hands. It's the whole game as it will launch, so this list is everything that's in it.",
    groups: [
      {
        title: "The guild",
        items: [
          "Hire a crew and set them to ten skills: Woodcutting, Mining, Fishing, Smithing, Cooking, Tailoring, Combat, Archery, Magic and Sailing.",
          "They keep working for up to 12 hours while the game is closed.",
          "Five tiers of arms and armour from scrap to tidesteel, with kits for sailors, archers and mages. All of it shows on whoever wears it.",
          "A guild hall to build up through ten levels, with perks to choose along four branches.",
        ],
      },
      {
        title: "Out in the world",
        items: [
          "Eighteen places to send a party, by land and by sea.",
          "Four raids to play by hand: the Old Mine, the Wolf Den, the Ruin and Smugglers' Cove.",
          "Ten ships, from the Raft to the Galleon, for voyages and trade runs.",
          "A second camp across the water at Saltmire.",
          "Watch a party on the road through the dragon's eyes and clear its way.",
        ],
      },
      {
        title: "Dragons",
        items: [
          "Four to raise: the Draigon, the Moss Drake, the Cinder Drake and the Gilt Drake.",
          "Each has five stages of trust and helps the guild in its own way.",
        ],
      },
      {
        title: "Life at camp",
        items: [
          "The work song: a rhythm game by the fire, played on drum, flute or lute.",
          "Camp spells to trace, three market carts, deeds to earn and a collection log.",
          "An angry chicken.",
        ],
      },
      {
        title: "Price",
        items: [
          `Free up to the crossing to Saltmire. One purchase (${site.price}) opens the rest. No ads.`,
        ],
      },
    ],
  },
];

const fmt = (iso: string) =>
  new Date(iso + "T12:00:00Z").toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---

<BaseLayout
  title="Patch Notes"
  description="What's new in Draigon Idle, version by version."
>
  <section class="page-head">
    <div class="container">
      <h1>Patch Notes</h1>
      <p>What's new, version by version.</p>
    </div>
  </section>

  <section class="page-body">
    <div class="container prose">
      {
        releases.map((r) => (
          <article class="panel release" id={`v${r.version}`}>
            <div class="release-head">
              <h2>Version {r.version}</h2>
              <time datetime={r.date}>{fmt(r.date)}</time>
              <span>{r.label}</span>
            </div>
            <p>{r.summary}</p>
            {r.groups.map((g) => (
              <>
                <h3>{g.title}</h3>
                <ul>
                  {g.items.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              </>
            ))}
          </article>
        ))
      }

      <p class="fine">
        Notes for versions 0.1 to 0.3 described an earlier form of the game. It was
        rebuilt from the ground up, and those notes no longer apply.
      </p>
    </div>
  </section>
</BaseLayout>
