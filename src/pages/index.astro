---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, skills } from "../data/site";

const features = [
  {
    icon: "/images/icon-guild.png",
    title: "A guild that keeps working",
    text: "Put your crew on jobs and they chop, mine, fish, forage, hunt, smith, cook and craft for hours while the game is closed. Checking in takes a few taps.",
  },
  {
    icon: "/images/icon-gear.png",
    title: "Gear you can see",
    text: "Tier after tier of arms and armour, starting from scrap. Everything a member wears is drawn on them.",
  },
  {
    icon: "/images/icon-dragon.png",
    title: "Dragons to raise",
    text: "A young dragon circles your camp from the first day. Feed it and it stays. There are others to find.",
  },
  {
    icon: "/images/icon-boss.png",
    title: "Bosses you fight yourself",
    text: "Lead the fight against each place's boss, seen from above. Melee beats Range, Range beats Magic, Magic beats Melee.",
  },
];
---

<BaseLayout title={site.name}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-copy">
      <p class="eyebrow">An idle guild game for iPhone and Android</p>
      <h1 id="hero-title">{site.name}</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <div class="btn-row">
        {
          site.appStoreUrl ? (
            <a href={site.appStoreUrl} class="btn" rel="noopener">Get it on the App Store</a>
          ) : (
            <a href={site.testFlightUrl || site.discord} class="btn" rel="noopener">Join the beta</a>
          )
        }
        <a href="#teaser" class="btn btn-ghost">Watch the teaser</a>
      </div>
      <p class="hero-note">
        {site.appStoreUrl ? "Free to start. No ads." : `${site.status}. Free to start, no ads.`}
      </p>
    </div>
    <img
      class="hero-art pixel"
      src="/images/hero-camp.png"
      width="780"
      height="420"
      alt="Briarhold's camp from above at night, as the game draws it: the guildhouse, the fire, the quest board, the cook pot, the forge and the dragon asleep in its nest."
    />
  </section>

  <section class="section" id="game" aria-labelledby="game-title">
    <div class="container">
      <p class="eyebrow">The game</p>
      <h2 id="game-title">Set them to work. Come back to more.</h2>
      <p class="lead">
        You lead a small guild in Briarhold. They gather, craft and set out by
        land and sea while you get on with your day. Check in to collect what
        they brought home, gear them up and send them further.
      </p>

      <ul class="feature-grid" role="list">
        {
          features.map((f) => (
            <li class="panel feature">
              <img class="pixel feature-icon" src={f.icon} alt="" width="16" height="16" loading="lazy" />
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="panel skills">
        <img class="pixel" src="/images/art-skills.png" alt="" width="256" height="16" loading="lazy" />
        <h3>{skills.length} skills to train</h3>
        <ul class="chips" role="list">
          {skills.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="teaser" aria-labelledby="teaser-title">
    <div class="container trailer-row">
      <div class="phone">
        <video
          controls
          playsinline
          preload="none"
          poster="/images/teaser-title.webp"
          width="720"
          height="1280"
          aria-label="Hatchfire teaser, 15 seconds"
        >
          <source src="/video/hatchfire-teaser.mp4" type="video/mp4" />
        </video>
      </div>
      <div>
        <p class="eyebrow">Teaser</p>
        <h2 id="teaser-title">An egg by the fire</h2>
        <p class="lead">
          Fifteen seconds, made from the game's own art and sounds.
        </p>
        <ul class="ticks" role="list">
          <li>Plays in short check-ins. No energy, no timers to pay past.</li>
          <li>Works offline. Sign in only if you want cloud saves.</li>
          <li>Waymeet, an online town: chat, spar, fish and raid with other players, if you like.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="price" aria-labelledby="price-title">
    <div class="container price-row">
      <div>
        <p class="eyebrow">Price</p>
        <h2 id="price-title">Free to start. One purchase for the rest.</h2>
        <p class="lead">
          All of Briarhold is free: the camp, its boss fights, Maren's boats and
          a fight at sea. One purchase of {site.price} opens the rest. No ads,
          and nothing else to buy.
        </p>
      </div>
      <div class="panel price-card">
        <p class="price-tag">{site.price}<span>once</span></p>
        <h3>The Saltmire Coast</h3>
        <ul class="ticks" role="list">
          <li>Saltmire: a second camp to build, across the water</li>
          <li>Marlow's big boats, up to the Galleon</li>
          <li>The Blue Lamp: the story goes on</li>
          <li>More places to sail and fight, and the woods beyond</li>
        </ul>
        <p class="fine">Price in US dollars. It varies by country.</p>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="follow" aria-labelledby="follow-title">
    <div class="container">
      <div class="panel follow">
        <h2 id="follow-title">Hear when it's out</h2>
        <p>
          One email when the game is out, and the odd one for a big update. Or
          play the beta now: ask for a place on the Discord, where bugs and ideas
          go too.
        </p>
        <div class="kit-embed">
          <script is:inline async data-uid={site.kitUid} src={site.kitSrc}></script>
        </div>
        <div class="btn-row">
          <a href={site.discord} class="btn" rel="noopener">Join the Discord</a>
          <a href={site.wiki} class="btn btn-ghost" rel="noopener">Read the wiki</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
