---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, skills } from "../data/site";

const features = [
  {
    art: "/images/art-guild.png",
    w: 176,
    h: 40,
    alt: "Guild members in work clothes: a woodcutter, a miner, a cook, a smith and an angler.",
    title: "A guild that keeps working",
    text: "Hire a crew and put them on jobs. They chop, mine, fish, smith, cook and weave for hours while the game is closed. Checking in takes a few taps.",
  },
  {
    art: "/images/art-gear.png",
    w: 176,
    h: 40,
    alt: "The same fighter in better and better armour, starting from scrap.",
    title: "Gear you can see",
    text: "Tier after tier of arms and armour, starting from scrap, plus kits for sailors, archers and mages. Everything a member wears is drawn on them.",
  },
  {
    art: "/images/art-dragons.png",
    w: 208,
    h: 40,
    alt: "A small teal dragon, and the dark outlines of others not yet met.",
    title: "Dragons to raise",
    text: "A young draigon circles your camp from the first day. Feed it and it stays. It isn't the only one. The others are for you to find.",
  },
  {
    art: "/images/art-raids.png",
    w: 208,
    h: 52,
    alt: "A fighter, an archer and a mage facing a wolf and a stone guardian.",
    title: "Raids you play yourself",
    text: "Go back to places you've beaten and fight them by hand. Time a heavy blow, draw a bow, trace a rune, parry the big hits. Some are fought on your ship's deck.",
  },
  {
    art: "/images/art-ships.png",
    w: 300,
    h: 84,
    alt: "A raft, a sloop and a galleon.",
    title: "From a raft to a galleon",
    text: "Build your boat up stage by stage. Send her on voyages, run cargo to market, and cross the water to a new camp at Saltmire.",
  },
  {
    art: "/images/art-camp.png",
    w: 135,
    h: 33,
    scale: 3,
    alt: "A market cart, a campfire, a small grey cat and a chicken.",
    title: "A camp with a life of its own",
    text: "Market carts roll in. A cat adopts your best mage. Now and then an angry chicken runs through camp. Catch it for a few coins.",
  },
];

const shots = [
  { src: "/images/shot-camp.webp", alt: "The guild's camp by day: a stone hall, a fire, a map board and a small teal dragon." },
  { src: "/images/shot-dragon.webp", alt: "The draigon at the camp." },
  { src: "/images/shot-map.webp", alt: "The world map, with places to send a party." },
  { src: "/images/shot-raid.webp", alt: "A raid in progress." },
  { src: "/images/shot-den.webp", alt: "A fight in the Wolf Den." },
  { src: "/images/shot-ruin.webp", alt: "The Ruin and its guardian." },
  { src: "/images/shot-watch.webp", alt: "The dragon's view of a party on the road." },
  { src: "/images/shot-back.webp", alt: "A party home from an expedition with what it found." },
  { src: "/images/shot-grow.webp", alt: "The guild grown larger." },
];
---

<BaseLayout title={site.name}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-copy">
      <p class="eyebrow">An idle guild game for iPhone</p>
      <h1 id="hero-title">Draigon Idle</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <div class="btn-row">
        {
          site.appStoreUrl ? (
            <a href={site.appStoreUrl} class="btn" rel="noopener">Get it on the App Store</a>
          ) : (
            <a href={site.testFlightUrl || site.discord} class="btn" rel="noopener">Join the beta</a>
          )
        }
        <a href="#trailer" class="btn btn-ghost">Watch the trailer</a>
      </div>
      <p class="hero-note">
        {site.appStoreUrl ? "Free to start. No ads." : `${site.status}. Free to start, no ads.`}
      </p>
    </div>
    <img
      class="hero-art pixel"
      src="/images/hero-night.png"
      width="480"
      height="210"
      alt="A guild camp at night: a stone hall with lit windows, three guild members round a fire, and a teal dragon under a crescent moon."
    />
  </section>

  <section class="section" id="game" aria-labelledby="game-title">
    <div class="container">
      <p class="eyebrow">The game</p>
      <h2 id="game-title">Set them to work. Come back to more.</h2>
      <p class="lead">
        You lead a small guild in Briarhold. They gather, craft and go out on
        expeditions while you get on with your day. When you check in, you
        collect what they brought home, gear them up and send them further.
      </p>

      <ul class="feature-grid" role="list">
        {
          features.map((f) => (
            <li class="panel feature">
              <div class="stage">
                <img
                  class="pixel"
                  src={f.art}
                  alt={f.alt}
                  width={f.w}
                  height={f.h}
                  style={`--w:${(f.w * (f.scale ?? 2)) / 2}`}
                  loading="lazy"
                />
              </div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="panel skills">
        <img class="pixel" src="/images/art-skills.png" alt="" width="196" height="20" loading="lazy" />
        <h3>Skills to train</h3>
        <ul class="chips" role="list">
          {skills.map((s) => <li>{s}</li>)}
        </ul>
      </div>

      <p class="growing">
        The game is still growing. More places, raids and dragons are on the way.
      </p>
    </div>
  </section>

  <section class="section section-alt" id="trailer" aria-labelledby="trailer-title">
    <div class="container trailer-row">
      <div class="phone">
        <video
          controls
          playsinline
          preload="none"
          poster="/images/shot-camp-plain.webp"
          width="720"
          height="1280"
          aria-label="Draigon Idle trailer, 30 seconds"
        >
          <source src="/video/draigon-idle-trailer.mp4" type="video/mp4" />
        </video>
      </div>
      <div>
        <p class="eyebrow">Trailer</p>
        <h2 id="trailer-title">Thirty seconds of it</h2>
        <p class="lead">
          The camp, the dragon, the map, a raid. Everything in the trailer is
          the game's own art.
        </p>
        <ul class="ticks" role="list">
          <li>Plays in short check-ins. No energy, no timers to pay past.</li>
          <li>Works offline. Your save stays on your phone.</li>
          <li>No account to make and nothing to sign in to.</li>
        </ul>
      </div>
    </div>

    <div class="container">
      <h3 class="strip-title">Scenes from the trailers</h3>
    </div>
    <ul class="shot-strip" role="list" tabindex="0" aria-label="Scenes from the trailers">
      {
        shots.map((s) => (
          <li>
            <img src={s.src} alt={s.alt} width="540" height="960" loading="lazy" />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" id="price" aria-labelledby="price-title">
    <div class="container price-row">
      <div>
        <p class="eyebrow">Price</p>
        <h2 id="price-title">Free to start. One purchase for the rest.</h2>
        <p class="lead">
          All of Briarhold is free: the camp, its raids, the first boats and a
          fight at sea. That's days of play before you pay anything.
        </p>
        <p class="lead">
          One purchase of {site.price} opens the Saltmire Coast. There are no ads and
          nothing else to buy.
        </p>
      </div>
      <div class="panel price-card">
        <p class="price-tag">{site.price}<span>once</span></p>
        <h3>The Saltmire Coast</h3>
        <ul class="ticks" role="list">
          <li>Saltmire: a new camp to build, across the water</li>
          <li>Bigger ships, up to the Galleon</li>
          <li>The Blue Lamp: the story goes on</li>
          <li>More places to sail and fight</li>
        </ul>
        <p class="fine">Price in US dollars. It varies by country.</p>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="follow" aria-labelledby="follow-title">
    <div class="container follow-row">
      <div class="panel">
        <h2 id="follow-title">Hear when it's out</h2>
        <p>One email when the game is on the App Store, and the odd one for a big update.</p>
        <div class="kit-embed">
          <script is:inline async data-uid={site.kitUid} src={site.kitSrc}></script>
        </div>
      </div>
      <div class="panel">
        <h2>Play it now</h2>
        <p>
          The beta runs through TestFlight. Ask for a place on the Discord. It's also
          where bugs and ideas go.
        </p>
        <div class="btn-row">
          <a href={site.discord} class="btn" rel="noopener">Join the Discord</a>
          <a href={site.wiki} class="btn btn-ghost" rel="noopener">Read the wiki</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
