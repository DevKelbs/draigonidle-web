---
import { site } from "../data/site";

const navLinks = [
  { href: "/#game", label: "The game" },
  { href: "/#trailer", label: "Trailer" },
  { href: "/patch-notes", label: "Patch notes" },
  { href: "/press-kit", label: "Press kit" },
  { href: site.wiki, label: "Wiki", external: true },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="container header-row">
    <a href="/" class="site-logo" aria-label={`${site.name}, home`}>
      <img src="/images/app-icon.png" alt="" width="32" height="32" class="pixel" />
      <span>{site.name}</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      {
        navLinks.map(({ href, label, external }) => (
          <a
            href={href}
            aria-current={path === href ? "page" : undefined}
            rel={external ? "noopener" : undefined}
          >
            {label}
          </a>
        ))
      }
      <a href={site.discord} class="btn btn-small" rel="noopener">Join the beta</a>
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Menu">
        <span></span><span></span><span></span>
      </summary>
      <nav aria-label="Main, small screens">
        {
          navLinks.map(({ href, label, external }) => (
            <a href={href} aria-current={path === href ? "page" : undefined} rel={external ? "noopener" : undefined}>
              {label}
            </a>
          ))
        }
        <a href={site.discord} rel="noopener">Join the beta on Discord</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the small-screen menu when one of its links is followed.
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-nav");
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => menu.removeAttribute("open")),
  );
</script>
