---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a href="/" class="site-logo">
        <img src="/images/app-icon.png" alt="" width="32" height="32" class="pixel" />
        <span>{site.name}</span>
      </a>
      <p class="footer-note">{site.tagline}</p>
    </div>

    <nav aria-label="Site">
      <p class="footer-heading">Site</p>
      <ul>
        <li><a href="/#game">The game</a></li>
        <li><a href="/patch-notes">Patch notes</a></li>
        <li><a href="/press-kit">Press kit</a></li>
        <li><a href={site.wiki} rel="noopener">Wiki</a></li>
      </ul>
    </nav>

    <nav aria-label="Community">
      <p class="footer-heading">Community</p>
      <ul>
        <li><a href={site.discord} rel="noopener">Discord</a></li>
        <li><a href={site.x} rel="noopener">X</a></li>
        <li><a href={site.reddit} rel="noopener">Reddit</a></li>
      </ul>
    </nav>

    <nav aria-label="Legal">
      <p class="footer-heading">Legal</p>
      <ul>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
      </ul>
    </nav>
  </div>
  <div class="container footer-base">
    <p>
      &copy; {year} {site.person}. {site.name} is made by {site.person}, publishing as
      {site.studioUrl ? <a href={site.studioUrl} rel="noopener">{site.studio}</a> : site.studio}.
    </p>
    <p>Apple, iPhone, App Store and TestFlight are trademarks of Apple Inc.</p>
  </div>
</footer>
